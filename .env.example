# 1) Copy this file to a new file named  .env.local  (same folder) and fill in the two values.
# 2) .env.local is private and is NEVER uploaded to GitHub (see .gitignore).
# 3) Use ONLY the publishable key (starts with sb_publishable_). Never use any secret key.
#
# Where to find them: Supabase Dashboard -> your project -> "Connect" button (top bar),
# or Project Settings -> API Keys / Data API.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
